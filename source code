<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  button { font-size: 18px; padding: 10px 20px; }
  #shop button { font-size: 14px; padding: 8px 12px; margin: 3px 0; }
  canvas { touch-action: manipulation; }
</style>
<canvas id="c" width="288" height="400"></canvas>
<p id="msg"></p>
<button id="potionBtn">Potion (0)</button>
<div id="choice" hidden>
  <button id="fightBtn">Fight</button>
  <button id="fleeBtn">Flee</button>
</div>
<div id="lootBox" hidden>
  <button id="equipBtn">Equip</button>
  <button id="leaveBtn">Leave</button>
</div>
<div id="shop" hidden></div>
<div id="panel"></div>
<script>
const ctx = c.getContext('2d'), T = 32;
const FLEE_CHANCE = 0.25;
const POTION_HEAL = 40;
const FOE_GEAR_CHANCE = 0.35;
const RAGE_BONUS = 3;
const map = [
  '####E####',
  '#......C#',
  '#.##.##.#',
  '#C..N...#',
  '#.#...#.#',
  '#.#.#.#.#',
  '#..M#..C#',
  '#.##.##.#',
  '#.......#',
  '#...S...#',
  '#########'
];
const colors = {'#': '#555', '.': '#222', 'S': '#222', 'E': '#fc3',
                'M': '#a6f', 'N': '#f6c', 'C': '#c80'};
const roll = (a, b) => a + Math.floor(Math.random() * (b - a + 1));

const slots = {
  weapon:  {label: 'Weapon',  items: [['Rusty Sword', 2], ['Iron Sword', 4], ['Steel Sword', 6]]},
  helmet:  {label: 'Helmet',  items: [['Leather Cap', 1], ['Iron Helm', 2], ['Steel Helm', 3]]},
  chest:   {label: 'Chest',   items: [['Leather Vest', 2], ['Chainmail', 3], ['Steel Plate', 4]]},
  bracers: {label: 'Bracers', items: [['Cloth Wraps', 1], ['Iron Bracers', 2], ['Steel Bracers', 3]]},
  greaves: {label: 'Greaves', items: [['Leather Boots', 1], ['Iron Greaves', 2], ['Steel Greaves', 3]]}
};
const armor = ['helmet', 'chest', 'bracers', 'greaves'];
const worn = {};
const power = k => worn[k] ? worn[k].power : 0;
const defense = () => armor.reduce((sum, k) => sum + power(k), 0);

const shops = {
  M: {title: 'Iron Merchant', tier: 1},
  N: {title: 'Steel Merchant', tier: 2}
};
const makeStock = tier => [
  {type: 'potion', name: 'Health Potion', price: 10},
  ...Object.keys(slots).map(k => {
    const [name, pow] = slots[k].items[tier];
    return {type: 'gear', slot: k, name, power: pow, price: pow * 5};
  })
];
let shopStock = [], shopTitle = '';

// gearTier = highest item tier the enemy can carry (leave it out for no gear)
// armorMax = most armor pieces it can wear (defaults to 1)
const types = [
  {name: 'Bat',      zone: 0, hp: 20,  dmg: [3, 7],   gold: [3, 7],   color: '#98a'},
  {name: 'Slime',    zone: 0, hp: 35,  dmg: [2, 6],   gold: [4, 9],   color: '#6c6'},
  {name: 'Goblin',   zone: 1, hp: 45,  dmg: [5, 9],   gold: [8, 14],  color: '#e94', gearTier: 0},
  {name: 'Skeleton', zone: 1, hp: 55,  dmg: [6, 10],  gold: [9, 16],  color: '#ddd', gearTier: 1},
  {name: 'Orc',      zone: 2, hp: 70,  dmg: [8, 13],  gold: [14, 22], color: '#c33', gearTier: 1, armorMax: 2},
  {name: 'Troll',    zone: 2, hp: 100, dmg: [10, 16], gold: [18, 28], color: '#a52'}
];
const BOSS = {name: 'Ogre King', hp: 150, dmg: [10, 16], gold: [50, 70], color: '#900', def: 2, boss: true};
const zoneOf = y => y >= 6 ? 0 : y >= 3 ? 1 : 2;
const pick = z => {
  const pool = types.filter(t => t.zone === z);
  return pool[roll(0, pool.length - 1)];
};

function groupSize(zone) {
  const r = Math.random();
  if (zone === 0) return 1;
  if (zone === 1) return r < 0.3 ? 2 : 1;
  return r < 0.15 ? 3 : r < 0.55 ? 2 : 1;
}

function equipFoe(f, t) {
  if (Math.random() < FOE_GEAR_CHANCE) {
    const [name, pow] = slots.weapon.items[roll(0, t.gearTier)];
    f.items.push(name);
    f.bonus = Math.ceil(pow / 2);
  }
  const free = [...armor];
  for (let n = 0; n < (t.armorMax || 1); n++) {
    if (Math.random() >= FOE_GEAR_CHANCE) continue;
    const k = free.splice(roll(0, free.length - 1), 1)[0];
    const [name, pow] = slots[k].items[roll(0, t.gearTier)];
    f.items.push(name);
    f.def += pow;
  }
}

function makeGroup(zone) {
  return Array.from({length: groupSize(zone)}, (_, i) => {
    const t = pick(i === 0 ? zone : roll(0, zone));
    const f = {...t, max: t.hp, bonus: 0, def: 0, items: []};
    if (t.gearTier !== undefined) equipFoe(f, t);
    return f;
  });
}

const describe = f => f.items.length ? `${f.name} (${f.items.join(', ')})` : f.name;

// tile (4,1) is the only way to the exit, so the boss can't be skipped
const enemies = [
  [1, 6], [6, 8], [3, 8],
  [4, 4], [7, 4], [3, 5], [6, 3],
  [1, 2], [7, 2]
].filter(([x, y]) => map[y][x] === '.')
 .map(([x, y]) => ({x, y, zone: zoneOf(y), group: null}));
enemies.push({
  x: 4, y: 1, zone: 2, boss: true,
  group: [{...BOSS, max: BOSS.hp, bonus: 0, items: []}]
});

let p = {x: 4, y: 9, hp: 100, max: 100};
let prev = {x: 4, y: 9};
let foes = [], current = null, pending = null;
let phase = 'explore', over = false;
let coins = 0, potions = 0;
const opened = new Set();

function showGear() {
  panel.innerHTML = Object.keys(slots).map(k =>
    `${slots[k].label}: ${worn[k] ? `${worn[k].name} (+${worn[k].power})` : 'empty'}`
  ).join('<br>') + `<br><b>Defense: ${defense()}</b><br>Coins: ${coins}<br>Potions: ${potions}`;
  potionBtn.textContent = `Potion (${potions})`;
}

function renderShop() {
  shop.innerHTML = `<b>${shopTitle}</b> (Coins: ${coins})<br>` + shopStock.map((it, i) => {
    const cur = it.type === 'gear' ? worn[it.slot] : null;
    const note = it.type === 'gear'
      ? ` (+${it.power}, now: ${cur ? `${cur.name} +${cur.power}` : 'empty'})`
      : ` (+${POTION_HEAL} HP)`;
    const off = coins < it.price || (cur && cur.power >= it.power) ? 'disabled' : '';
    return `<button data-i="${i}" ${off}>${it.name}${note} - ${it.price}c</button>`;
  }).join('<br>') + '<br><button id="shopLeave">Leave shop</button>';
}

function loot(maxTier = 2, minTier = 0) {
  const k = Object.keys(slots)[roll(0, 4)];
  const [name, pow] = slots[k].items[roll(minTier, maxTier)];
  pending = {slot: k, name, power: pow};
  phase = 'loot';
  lootBox.hidden = false;
  const cur = worn[k];
  return `Found ${name} (+${pow}). ` + (cur
    ? `You wear ${cur.name} (+${cur.power}).`
    : `Your ${slots[k].label} slot is empty.`);
}

function openChest(key) {
  opened.add(key);
  const r = roll(1, 3);
  if (r === 1) {
    const gold = roll(10, 25);
    coins += gold;
    showGear();
    return `It holds ${gold} coins!`;
  }
  if (r === 2) {
    potions++;
    showGear();
    return 'It holds a health potion!';
  }
  return 'It holds equipment. ' + loot();
}

function closeLoot() {
  pending = null;
  lootBox.hidden = true;
  phase = 'explore';
  showGear();
}

function bar(x, y, w, h, hp, max, color) {
  ctx.fillStyle = '#400';
  ctx.fillRect(x, y, w, h);
  ctx.fillStyle = color;
  ctx.fillRect(x, y, w * hp / max, h);
}

function draw() {
  map.forEach((row, y) => [...row].forEach((ch, x) => {
    ctx.fillStyle = ch === 'C' && opened.has(`${x},${y}`) ? '#432' : colors[ch];
    ctx.fillRect(x * T, y * T, T, T);
  }));
  enemies.filter(e => (e.seen || e.boss) && !e.dead).forEach(e => {
    ctx.fillStyle = e.group[0].color;
    ctx.fillRect(e.x * T, e.y * T, T, T);
    if (e.boss) {
      ctx.strokeStyle = '#fff';
      ctx.strokeRect(e.x * T + 1, e.y * T + 1, T - 2, T - 2);
    }
  });
  ctx.fillStyle = '#4af';
  ctx.fillRect(p.x * T + 8, p.y * T + 8, T - 16, T - 16);

  ctx.fillStyle = '#111';
  ctx.fillRect(0, 352, 288, 48);
  ctx.fillStyle = '#fff';
  ctx.font = '12px sans-serif';
  ctx.fillText('You', 8, 368);
  bar(8, 374, 120, 12, p.hp, p.max, '#4c4');
  foes.filter(f => f.hp > 0).forEach((f, i) => {
    ctx.fillStyle = '#fff';
    ctx.font = '10px sans-serif';
    ctx.fillText(f.name + (f.items.length ? '*' : ''), 150, 364 + i * 14);
    bar(200, 356 + i * 14, 80, 8, f.hp, f.max, f.color);
  });
}

function foesAttack() {
  for (const f of foes.filter(f => f.hp > 0)) {
    const rage = f.raged ? RAGE_BONUS : 0;
    const hurt = Math.max(1, roll(f.dmg[0], f.dmg[1]) + f.bonus + rage - defense());
    p.hp = Math.max(0, p.hp - hurt);
    msg.textContent += ` ${f.name} hits you for ${hurt}.`;
    if (p.hp === 0) {
      over = true;
      msg.textContent = 'You died. Refresh to try again.';
      return;
    }
  }
}

function attack() {
  const t = foes.find(f => f.hp > 0);
  const dmg = Math.max(1, roll(8, 14) + power('weapon') - t.def);
  t.hp = Math.max(0, t.hp - dmg);
  msg.textContent = `You hit ${t.name} for ${dmg}.`;
  if (t.hp === 0) {
    const gold = roll(t.gold[0], t.gold[1]);
    coins += gold;
    msg.textContent += ` ${t.name} defeated! +${gold} coins.`;
    showGear();
  } else if (t.boss && !t.raged && t.hp <= t.max / 2) {
    t.raged = true;
    msg.textContent += ` The ${t.name} roars in a rage!`;
  }
  if (foes.some(f => f.hp > 0)) {
    foesAttack();
  } else {
    current.dead = true;
    if (current.boss) {
      msg.textContent += ' The way to the exit is clear! ' + loot(2, 2);
    } else {
      msg.textContent += ' ' + loot(current.zone);
    }
    foes = [];
    current = null;
  }
  draw();
}

potionBtn.onclick = () => {
  if (over || (phase !== 'explore' && phase !== 'fight')) return;
  if (!potions) { msg.textContent = 'No potions left.'; return; }
  if (p.hp === p.max) { msg.textContent = 'Already at full health.'; return; }
  potions--;
  const heal = Math.min(POTION_HEAL, p.max - p.hp);
  p.hp += heal;
  msg.textContent = `You drink a potion and heal ${heal}.`;
  if (phase === 'fight') foesAttack();
  showGear();
  draw();
};

shop.onclick = e => {
  const b = e.target.closest('button');
  if (!b) return;
  if (b.id === 'shopLeave') {
    shop.hidden = true;
    phase = 'explore';
    msg.textContent = '';
    return;
  }
  const it = shopStock[b.dataset.i];
  if (coins < it.price) return;
  coins -= it.price;
  if (it.type === 'potion') {
    potions++;
    msg.textContent = 'Bought a health potion.';
  } else {
    worn[it.slot] = {name: it.name, power: it.power};
    msg.textContent = `Bought and equipped ${it.name}.`;
  }
  showGear();
  renderShop();
};

fightBtn.onclick = () => {
  choice.hidden = true;
  phase = 'fight';
  msg.textContent = 'Tap to attack.';
  draw();
};

fleeBtn.onclick = () => {
  choice.hidden = true;
  if (Math.random() < FLEE_CHANCE) {
    p.x = prev.x;
    p.y = prev.y;
    foes = [];
    current = null;
    phase = 'explore';
    msg.textContent = 'You slipped away!';
  } else {
    phase = 'fight';
    msg.textContent = 'Flee failed!';
    foesAttack();
    if (!over) msg.textContent += ' Tap to attack.';
  }
  draw();
};

equipBtn.onclick = () => {
  worn[pending.slot] = {name: pending.name, power: pending.power};
  msg.textContent = `Equipped ${pending.name}.`;
  closeLoot();
};

leaveBtn.onclick = () => {
  msg.textContent = `Left the ${pending.name} behind.`;
  closeLoot();
};

c.addEventListener('pointerdown', e => {
  if (over || (phase !== 'explore' && phase !== 'fight')) return;
  if (phase === 'fight') return attack();

  const r = c.getBoundingClientRect();
  const dx = e.clientX - r.left - c.width / 2;
  const dy = e.clientY - r.top - 176;
  let nx = p.x, ny = p.y;
  if (Math.abs(dx) > Math.abs(dy)) nx += Math.sign(dx);
  else ny += Math.sign(dy);
  if (!map[ny] || map[ny][nx] === '#') return;
  prev = {x: p.x, y: p.y};
  p.x = nx;
  p.y = ny;
  msg.textContent = '';

  const key = `${nx},${ny}`;
  const hit = enemies.find(e => e.x === nx && e.y === ny && !e.dead);
  const sh = shops[map[ny][nx]];
  if (hit) {
    if (!hit.group) hit.group = makeGroup(hit.zone);
    hit.seen = true;
    current = hit;
    foes = hit.group;
    phase = 'choice';
    choice.hidden = false;
    const live = foes.filter(f => f.hp > 0);
    const bossFoe = live.find(f => f.boss);
    fleeBtn.disabled = !!bossFoe;
    msg.textContent = bossFoe
      ? `The ${bossFoe.name} blocks the exit! No running from this one.`
      : live.length > 1
        ? `Enemies appear: ${live.map(describe).join(', ')}!`
        : `A ${describe(live[0])} appears!`;
  } else if (sh) {
    shopStock = makeStock(sh.tier);
    shopTitle = sh.title;
    phase = 'shop';
    renderShop();
    shop.hidden = false;
    msg.textContent = "Merchant: what'll it be?";
  } else if (map[ny][nx] === 'C' && !opened.has(key)) {
    msg.textContent = 'You open a chest! ' + openChest(key);
  }
  draw();
  if (map[ny][nx] === 'E') setTimeout(() => alert('You escaped the dungeon!'), 50);
});

draw();
showGear();
</script>
